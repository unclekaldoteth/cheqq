generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id              String              @id @default(cuid())
  name            String
  email           String              @unique
  walletAddress   String?
  kybDocumentUrl  String?
  logo            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  walletRoles     CompanyWalletRole[]
  employees       Employee[]
  invoices        Invoice[]           @relation("CompanyInvoices")
  kybCredentials  KybCredential[]
  payrollRuns     PayrollRun[]
  treasuryBalance TreasuryBalance[]
}

model Employee {
  id            String         @id @default(cuid())
  companyId     String
  name          String
  email         String
  walletAddress String
  salary        Decimal        @db.Decimal(18, 2)
  currency      Currency       @default(USDC)
  status        EmployeeStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id])
  loans         Loan[]
  payrollItems  PayrollItem[]
}

model PayrollRun {
  id          String        @id @default(cuid())
  companyId   String
  totalAmount Decimal       @db.Decimal(18, 2)
  currency    Currency      @default(USDC)
  status      PayrollStatus @default(PENDING)
  txHash      String?
  scheduledAt DateTime?
  executedAt  DateTime?
  createdAt   DateTime      @default(now())
  items       PayrollItem[]
  company     Company       @relation(fields: [companyId], references: [id])
}

model PayrollItem {
  id            String        @id @default(cuid())
  payrollRunId  String
  employeeId    String
  grossAmount   Decimal       @db.Decimal(18, 2)
  loanDeduction Decimal       @default(0) @db.Decimal(18, 2)
  netAmount     Decimal       @db.Decimal(18, 2)
  txHash        String?
  status        PaymentStatus @default(PENDING)
  employee      Employee      @relation(fields: [employeeId], references: [id])
  payrollRun    PayrollRun    @relation(fields: [payrollRunId], references: [id])
}

model Loan {
  id               String     @id @default(cuid())
  employeeId       String
  amount           Decimal    @db.Decimal(18, 2)
  remainingAmount  Decimal    @db.Decimal(18, 2)
  monthlyDeduction Decimal    @db.Decimal(18, 2)
  currency         Currency   @default(USDC)
  status           LoanStatus @default(ACTIVE)
  approvedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  employee         Employee   @relation(fields: [employeeId], references: [id])
}

model TreasuryBalance {
  id          String   @id @default(cuid())
  companyId   String
  currency    Currency
  balance     Decimal  @db.Decimal(18, 6)
  yieldEarned Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, currency])
}

model Freelancer {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  walletAddress   String
  idDocumentUrl   String?
  profession      String?
  linkedinUrl     String?
  githubUrl       String?
  twitterUrl      String?
  portfolioUrl    String?
  bio             String?
  reputationScore Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  invoices        Invoice[]       @relation("FreelancerInvoices")
  kycCredentials  KycCredential[]
  withdrawals     Withdrawal[]
}

model Invoice {
  id           String        @id @default(cuid())
  companyId    String?
  freelancerId String?
  clientName   String
  clientEmail  String
  description  String
  amount       Decimal       @db.Decimal(18, 2)
  currency     Currency      @default(USDC)
  status       InvoiceStatus @default(DRAFT)
  dueDate      DateTime
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company?      @relation("CompanyInvoices", fields: [companyId], references: [id])
  freelancer   Freelancer?   @relation("FreelancerInvoices", fields: [freelancerId], references: [id])
  payments     Payment[]
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  amount       Decimal       @db.Decimal(18, 2)
  currency     Currency
  status       PaymentStatus @default(PENDING)
  txHash       String?
  payerAddress String?
  createdAt    DateTime      @default(now())
  confirmedAt  DateTime?
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
}

model Withdrawal {
  id              String         @id @default(cuid())
  freelancerId    String
  amount          Decimal        @db.Decimal(18, 2)
  currency        Currency
  destinationType WithdrawalType
  destination     String
  status          PaymentStatus  @default(PENDING)
  txHash          String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  freelancer      Freelancer     @relation(fields: [freelancerId], references: [id])
}

model KycCredential {
  id             String      @id @default(cuid())
  freelancerId   String
  walletAddress  String
  level          Int         @default(1)
  dataRoot       String
  attestationUid String?
  chainId        Int
  expiresAt      DateTime
  revokedAt      DateTime?
  provider       KycProvider @default(MANUAL)
  providerRefId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  freelancer     Freelancer  @relation(fields: [freelancerId], references: [id])

  @@unique([freelancerId, chainId])
  @@index([walletAddress])
  @@index([attestationUid])
}

model KybCredential {
  id             String      @id @default(cuid())
  companyId      String
  companyHash    String
  level          Int         @default(1)
  dataRoot       String
  attestationUid String?
  chainId        Int
  expiresAt      DateTime
  revokedAt      DateTime?
  provider       KycProvider @default(MANUAL)
  providerRefId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  company        Company     @relation(fields: [companyId], references: [id])

  @@unique([companyId, chainId])
  @@index([companyHash])
  @@index([attestationUid])
}

model CompanyWalletRole {
  id             String      @id @default(cuid())
  companyId      String
  walletAddress  String
  role           CompanyRole @default(OPERATOR)
  attestationUid String?
  chainId        Int
  grantedBy      String?
  revokedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  company        Company     @relation(fields: [companyId], references: [id])

  @@unique([companyId, walletAddress, chainId])
  @@index([walletAddress])
}

model PermitNonce {
  id             String    @id @default(cuid())
  subjectAddress String
  chainId        Int
  nonce          BigInt
  usedAt         DateTime?
  permitHash     String?
  action         String?
  createdAt      DateTime  @default(now())

  @@unique([subjectAddress, chainId, nonce])
  @@index([subjectAddress, chainId])
}

model KycSalt {
  id          String      @id @default(cuid())
  subjectType SubjectType
  subjectId   String
  saltNonce   Int         @default(1)
  createdAt   DateTime    @default(now())

  @@unique([subjectType, subjectId])
}

model AuditLog {
  id             String   @id @default(cuid())
  eventType      String
  subjectAddress String?
  action         String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([subjectAddress])
  @@index([eventType, createdAt])
}

model BlockedSubject {
  id             String    @id @default(cuid())
  subjectAddress String    @unique
  reason         String
  blockedBy      String?
  blockedUntil   DateTime?
  createdAt      DateTime  @default(now())
}

enum Currency {
  USDC
  IDRX
  ETH
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayrollStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum LoanStatus {
  PENDING
  ACTIVE
  PAID
  DEFAULTED
}

enum WithdrawalType {
  BANK
  CRYPTO
}

enum KycProvider {
  MANUAL
  SUMSUB
  JUMIO
  PERSONA
}

enum CompanyRole {
  OWNER
  ADMIN
  OPERATOR
}

enum SubjectType {
  FREELANCER
  COMPANY
}
